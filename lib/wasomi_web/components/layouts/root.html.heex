<!DOCTYPE html>
<html lang="en" class="scroll-smooth [scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Wasomi" suffix={assigns[:page_title_suffix] || " · Wasomi"}>
      {assigns[:page_title]}
    </.live_title>
    <meta
      name="description"
      content={
        assigns[:meta_description] ||
          "Practical GS1 standards courses for professionals and businesses."
      }
    />
    <meta name="robots" content={assigns[:meta_robots] || "noindex, nofollow"} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />

    <meta property="og:site_name" content="Wasomi" />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:title" content={assigns[:page_title] || "Wasomi"} />
    <meta
      property="og:description"
      content={
        assigns[:meta_description] ||
          "Practical GS1 standards courses for professionals and businesses."
      }
    />
    <meta :if={assigns[:canonical_url]} property="og:url" content={assigns[:canonical_url]} />
    <meta property="og:image" content={assigns[:meta_image] || url(~p"/images/hero-home.png")} />
    <meta property="og:image:alt" content={assigns[:meta_image_alt] || "Learn with Wasomi"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Wasomi"} />
    <meta
      name="twitter:description"
      content={
        assigns[:meta_description] ||
          "Practical GS1 standards courses for professionals and businesses."
      }
    />
    <meta name="twitter:image" content={assigns[:meta_image] || url(~p"/images/hero-home.png")} />

    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="icon" type="image/png" sizes="64x64" href={~p"/favicon.ico"} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1" defer>
    </script>
    <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" defer>
    </script>
    <%!-- render=explicit, not bound to one site key: the v3 site (executed
    programmatically via grecaptcha.execute) and the v2 fallback checkbox
    (rendered via grecaptcha.render) share this one script load. --%>
    <script
      :if={Wasomi.Security.Captcha.enabled?() or Wasomi.Security.Captcha.v2_enabled?()}
      src="https://www.google.com/recaptcha/api.js?render=explicit"
      async
      defer
    >
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    />
  </head>
  <body class="bg-white">
    {@inner_content}
  </body>
</html>
