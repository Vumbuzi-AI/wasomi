# AI
OPENAI_API_KEY=replace-with-openai-api-key
# Optional — defaults to gpt-5.4-mini if unset.
OPENAI_MODEL=gpt-5.4-mini

# Email delivery via MailSafi Postal
# Required in production. Optional in development; when absent, emails use /dev/mailbox.
POSTAL_API_KEY=replace-with-mailsafi-postal-api-key
POSTAL_API_URL=https://postalmail.mailsafi.com/api/v1/send/message
POSTAL_FROM_ADDRESS=no-reply@gs1kenya.org
POSTAL_FROM_NAME=Wasomi

# Payments
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:4590/payments/paystack/callback

# Cloudflare Stream
# Required in production. Optional in development; when absent, dev uses the demo media provider.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=replace-with-cloudflare-stream-api-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace-with-cloudflare-stream-customer-code
CLOUDFLARE_STREAM_SIGNING_KEY_ID=replace-with-cloudflare-stream-signing-key-id
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=replace-with-cloudflare-stream-signing-private-key
CLOUDFLARE_API_URL=https://api.cloudflare.com
CLOUDFLARE_STREAM_ORIGIN=http://localhost:4590

# Cloudflare R2 storage
R2_BUCKET=replace-with-r2-bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://replace-with-public-r2-domain
R2_UPLOAD_EXPIRY=3600

# Production/runtime
PHX_HOST=wasomi-ai.com
PHX_SERVER=true
PORT=4000
DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
POOL_SIZE=10
ECTO_IPV6=false
START_CHROMIC_PDF=true
CHROME_EXECUTABLE=
DNS_CLUSTER_QUERY=
